{
  "name": "bioreader",
  "version": "0.1.0",
  "description": "BioReader: Intelligent scientific PDF reader and literature workspace for bioinformatics researchers",
  "main": "electron/main.js",
  "author": "Burak Bulut <burak.buluut@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/BurakBulut-sh/BioReader.git"
  },
  "homepage": "https://github.com/BurakBulut-sh/BioReader#readme",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node --test tests/unit.test.js",
    "lint": "eslint .",
    "glossary:generate": "node scripts/generateGlossary.js",
    "package:mac": "vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tiptap/extension-mention": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.27.2",
    "better-sqlite3": "^12.6.2",
    "classnames": "^2.5.1",
    "docx": "^9.5.1",
    "framer-motion": "^11.15.0",
    "fuse.js": "^7.1.0",
    "lodash.debounce": "^4.0.8",
    "pdfjs-dist": "^4.10.38",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-pdf": "^9.2.1",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.1.14",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.1.2",
    "electron": "^35.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.bioreader.desktop",
    "productName": "BioReader",
    "files": [
      "dist-react/**/*",
      "electron/**/*",
      "package.json",
      "src/data/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
